# Source imagery cache. Never commit: manifest.csv files embed a Google Maps API key.
data/
.DS_Store

# Canonical Natanz re-upload (source imagery; its manifest.csv embeds an API key). Never commit.
NEW_natanz/

# Source data at the repo root: read by the benchmark, never committed (anchored to the root on purpose)
/*.docx
/*.xlsx
/*_all_results.csv
/*_report_light/

# Downloads, caches and imagery anywhere in the repo
*.zip
*.npy
manifest.csv

# Vendored third-party code (Qiqi's extraction repo; cloned, pinned in cnn_benchmark/external_data/extraction_config.yaml)
vendor/

# External training imagery + its vendor manifests/logs (coordinates; manifests may hold an API key before sanitizing)
external_imagery/
.env
.env.*

# Yanliang's external positive coordinates (private; never commit)
/Reviewed fence list.csv

# --- results/ and figures/ (repo-level, paper-facing; added in the 2026-10-23 cleanup) ---
# PNGs regenerated by the aggregation scripts land next to their tables; the curated copies live in figures/
results/**/*.png
!results/qa/artifact_audit/*.png
results/**/_runs_view/
results/**/*.log
# coordinate-bearing QA / audit outputs (local only)
results/qa/benchmark_facility_checks/benchmark_facility_centroids.csv
results/qa/extraction_audit/extraction_audit_table.csv
results/robustness/saratov_auto_mosaic/extraction_summary.csv
# legacy re-scores duplicate the frozen per-run scores (provenance/run_records/runs/C/seed*/benchmark/scores.csv)
results/robustness/saratov_auto_mosaic/scores_legacy_rescored_seed*.csv

# --- local-only material (added 2026-10-23 after the data migration) ---
# machine-local migration manifests and scratch (file names can reveal private data)
/_local/
# run / stdout logs written next to pipeline outputs (dry runs, aggregation stdout); provenance/ logs stay tracked
cnn_benchmark/outputs/**/*.log
# dataset-preparation tables: external candidate / selected sites with coordinates (never track)
cnn_benchmark/outputs/external_data/*.csv
# pre-reorganisation output location (superseded mixed-backend tables, stdout logs); current results live in results/
cnn_benchmark/outputs/ablation/results_robustness/

# model checkpoints anywhere (run records under provenance/ keep only their SHA-256 in checksums.sha256)
*.pt
*.pth
*.ckpt
